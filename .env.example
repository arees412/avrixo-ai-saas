# Copy using python scripts/setup_env.py; never commit .env.
FASTAPI_ENV=development
PROJECT_NAME="Avrixo AI SaaS"
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@127.0.0.1:5432/app
# Server-managed endpoint; use HTTPS outside localhost.
AI_BASE_URL=
AI_API_KEY=
AI_DEFAULT_MODEL=
AI_TIMEOUT_SECONDS=45
